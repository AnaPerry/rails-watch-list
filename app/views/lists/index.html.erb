<div class="container m-5">
  <h1>Movies lists</h1>
  <hr>
  <%= link_to "+", lists_create_path, class:"btn btn-success" %>
  <div class="cards">
    <% @lists.each do |list| %>
    <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('<%= asset_path(list.list_url) %>')">
      <%= list.name %>
    <% end %>
    </div>
  </div>
</div>

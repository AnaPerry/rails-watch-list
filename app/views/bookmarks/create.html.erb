<div class="container">
  <h1>Create a new bookmark for <%= @bookmark.movie.title %> in the list <%= @bookmark.list.name %></h1>
  <div class="row">
    <div clas="col-6">
      <%= simple_form_for [@bookmark, @list, @movie] do |f| %>
        <%= f.input :comment %>
        <%= f.submit %>
      <% end %>
    </div>
  </div>
</div>

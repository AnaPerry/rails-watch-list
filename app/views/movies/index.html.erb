<div class="container m-5">
  <h1>All Movies</h1>
  <hr>
  <%= link_to "+", movie_create_path, class:"btn btn-success" %>
  <div class="cards">
    <% @movies.each do |movie| %>
    <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('<%= asset_path(movie.poster_url) %>')">
      <%= movie.title %>
      <%= movie.rating %>
    <% end %>
    </div>
  </div>
</div>
